{
  "name": "@webhook-portal/reference-server-core",
  "version": "0.1.0",
  "description": "Open reference webhook-portal server runtime: Fastify HTTP surface, Postgres and in-memory repositories, and MinIO/in-memory payload storage.",
  "keywords": [
    "webhook",
    "webhooks",
    "reference-server",
    "fastify",
    "postgres"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HookShip/toolkit.git",
    "directory": "packages/reference-server-core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "node ../../scripts/test-coverage.mjs --project packages/reference-server-core",
    "test:integration": "vitest run test/reference-migrations.test.ts test/reference-repository.contract.test.ts test/reference-minio.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@types/pg": "^8.20.0",
    "@webhook-portal/adapter-generic-http": "workspace:*",
    "@webhook-portal/adapter-sdk": "workspace:*",
    "@webhook-portal/contract-core": "workspace:*",
    "@webhook-portal/signing": "workspace:*",
    "fastify": "^5.12.1",
    "minio": "^8.0.7",
    "pg": "^8.22.0"
  }
}
