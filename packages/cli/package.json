{
  "name": "@webhook-portal/cli",
  "version": "0.1.0",
  "description": "Command-line tooling for local webhook contract workflows.",
  "keywords": [
    "webhook",
    "webhooks",
    "cli",
    "openapi",
    "asyncapi",
    "standard-webhooks"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HookShip/toolkit.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "webhook-portal": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reference-server": {
      "types": "./dist/reference-server/index.d.ts",
      "import": "./dist/reference-server/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "node ../../scripts/test-coverage.mjs --project packages/cli",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@webhook-portal/adapter-generic-http": "workspace:*",
    "@webhook-portal/adapter-sdk": "workspace:*",
    "@webhook-portal/canonical-model": "workspace:*",
    "@webhook-portal/compatibility-report": "workspace:*",
    "@webhook-portal/contract-core": "workspace:*",
    "@webhook-portal/migration-assessment": "workspace:*",
    "@webhook-portal/signing": "workspace:*",
    "@webhook-portal/support-evidence": "workspace:*",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@webhook-portal/reference-server-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@webhook-portal/reference-server-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@webhook-portal/reference-server-core": "workspace:*"
  }
}
